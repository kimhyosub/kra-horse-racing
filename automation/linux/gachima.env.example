# 가치마 서버 설정·비밀값. install.sh 가 /etc/gachima.env 로 복사한다 (저장소에는 이 예시만).
# 고치기:  sudo nano /etc/gachima.env   → 저장 후  sudo systemctl restart gachima-web
# 값에 공백이나 $ ! # 같은 기호가 있으면 작은따옴표로 감싸세요:  GACHIMA_LOGIN_PASSWORD='a$b!c'
# 이 파일 내용은 채팅·저장소·스크린샷에 올리지 마세요.

# ---- 꼭 넣을 것 ----
KRA_SERVICE_KEY=
GACHIMA_LOGIN_USER=admin
GACHIMA_LOGIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
GACHIMA_TELEGRAM_CHATS=

# ---- 있으면 ----
ANTHROPIC_API_KEY=
GACHIMA_ADSENSE_CLIENT=
GACHIMA_GSC_VERIFY=
GACHIMA_CONTACT=
GACHIMA_NAVER_VERIFY=
# 다음은 robots.txt 에 넣을 한 줄 전체를 작은따옴표로: GACHIMA_DAUM_VERIFY='#DaumWebMasterTool:...'
GACHIMA_DAUM_VERIFY=

# ---- 경로 (보통 그대로) ----
GACHIMA_PUBLIC_URL=https://gachima.co.kr
GACHIMA_DATA=/srv/kra-data
GACHIMA_DB=/srv/kra-data/db/gachima
GACHIMA_IMPORT_DIR=/srv/kra-data/web
GACHIMA_UPLOAD_DIR=/srv/kra-data/uploads
GACHIMA_USERS_FILE=/srv/kra-data/gachima-users.properties
